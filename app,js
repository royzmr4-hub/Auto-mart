  "DOMContentLoaded",
  () => {

    // Storefront

    if (
      document.getElementById(
        "productGrid"
      )
    ) {

      loadProducts();


      const searchInput =
        document.getElementById(
          "searchInput"
        );


      if (searchInput) {

        searchInput.addEventListener(
          "input",
          searchProducts
        );

      }

    }


    // Admin

    if (
      document.getElementById(
        "adminProductList"
      )
    ) {

      loadAdminProducts();

    }


    // Checkout

    const checkoutForm =
      document.getElementById(
        "checkoutForm"
      );


    if (checkoutForm) {

      checkoutForm.addEventListener(
        "submit",
        submitOrder
      );

    }

  }
);


