// ==========================================
// ADMIN - DELETE
// ==========================================

async function deleteProduct(
  productId
) {

  const confirmed =
    confirm(
      "Энэ бүтээгдэхүүнийг устгах уу?"
    );


  if (!confirmed) return;


  const {
    error
  } =
    await supabaseClient
      .from("products")
      .delete()
      .eq(
        "id",
        productId
      );


  if (error) {

    console.error(error);

    showToast(
      "Устгахад алдаа гарлаа."
    );

    return;

  }


  showToast(
    "Бараа устгагдлаа."
  );


  loadAdminProducts();

}


